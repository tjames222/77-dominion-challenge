{
  "name": "77-dominion-challenge",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build-frontend.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test src/static/*.test.mjs",
    "test:frontend": "pnpm run test",
    "check:frontend": "pnpm run test:frontend && pnpm run build",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config=playwright.fou-1452.config.mjs",
    "test:e2e:local-production": "bash scripts/rehearse-local-production-stack.sh",
    "test:e2e:headed": "playwright test --headed --project=chromium-functional",
    "test:e2e:update": "playwright test --update-snapshots=all",
    "test:quality": "pnpm test && pnpm build && pnpm test:e2e",
    "supabase:start": "bash scripts/start-local-database.sh",
    "supabase:stop": "supabase stop --no-backup",
    "supabase:reset": "bash scripts/reset-local-database.sh",
    "check:migrations": "node scripts/check-migration-compatibility.mjs",
    "test:migration-compatibility": "node --test scripts/check-migration-compatibility.test.mjs scripts/verify-production-migration-cutover-plan.test.mjs scripts/verify-production-raw-migration-history.test.mjs scripts/verify-production-canary-cutover-gate.test.mjs",
    "test:reconciliation-stage": "node --test scripts/prepare-reconciliation-stage.test.mjs scripts/verify-reconciliation-history.test.mjs scripts/rehearse-history-reconciliation.test.mjs",
    "test:migration-atomicity": "bash scripts/test-migration-atomicity.sh",
    "test:profile-photo-cleanup-cron": "node --test scripts/profile-photo-cleanup-cron-rehearsal.test.mjs",
    "rehearse:profile-photo-cleanup-cron": "bash scripts/rehearse-profile-photo-cleanup-cron.sh",
    "test:production-backup-restore": "node --test scripts/production-backup-restore.test.mjs",
    "test:production-reconciliation": "node --test scripts/verify-production-reconciliation-preflight.test.mjs scripts/run-production-reconciliation-step.test.mjs",
    "capture:production-backup": "bash scripts/capture-production-backup.sh",
    "rehearse:production-backup-restore": "bash scripts/rehearse-production-backup-restore.sh",
    "verify:production-backup-evidence": "bash scripts/verify-production-backup-evidence.sh",
    "verify:production-reconciliation-preflight": "bash scripts/verify-production-reconciliation-preflight.sh",
    "prepare:production-reconciliation-plan": "node scripts/production-reconciliation-artifacts.mjs prepare-plan",
    "run:production-reconciliation-step": "bash scripts/run-production-reconciliation-step.sh",
    "verify:production-reconciliation-completion": "node scripts/production-reconciliation-artifacts.mjs verify-completion",
    "test:database-manifest": "node --test scripts/database-manifest.test.mjs",
    "test:baseline-reconciliation": "bash scripts/rehearse-baseline-reconciliation.sh",
    "generate:baseline-reconciliation": "bash scripts/rehearse-baseline-reconciliation.sh --regenerate",
    "rehearse:history-reconciliation": "bash scripts/rehearse-history-reconciliation.sh",
    "test:database": "pnpm run test:database-runner && bash scripts/test-database.sh",
    "test:database-runner": "node --test scripts/test-database-runner.test.mjs",
    "test:rpc": "bash supabase/tests/integration/rpc-concurrency.sh && bash supabase/tests/integration/profile-photo-concurrency.sh && bash supabase/tests/integration/crew-lifecycle-concurrency.sh && bash supabase/tests/integration/crew-invite-code-concurrency.sh && bash supabase/tests/integration/crew-training-concurrency.sh && bash supabase/tests/integration/challenge-activation-concurrency.sh && bash supabase/tests/integration/challenge-activation-backfill.sh && bash supabase/tests/integration/site-training-concurrency.sh && bash supabase/tests/integration/group-challenge-start-concurrency.sh && bash supabase/tests/integration/solo-training-catalog-concurrency.sh && bash supabase/tests/integration/member-progress-profile-concurrency.sh",
    "test:profile-photo-races": "bash supabase/tests/integration/profile-photo-concurrency.sh",
    "check:schema": "bash scripts/check-schema-drift.sh",
    "check:functions": "cd supabase && deno task fmt:check && deno task check",
    "test:functions": "cd supabase && deno task test",
    "check:database": "pnpm run check:migrations && pnpm run test:migration-compatibility && pnpm run test:reconciliation-stage && pnpm run test:production-backup-restore && pnpm run test:production-reconciliation && pnpm run test:database-manifest && pnpm run supabase:reset && pnpm run test:migration-atomicity && pnpm run test:database && pnpm run test:rpc && pnpm run check:schema",
    "check:backend": "pnpm run test:profile-photo-cleanup-cron && pnpm run check:database && pnpm run check:functions && pnpm run test:functions"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "qrcode": "1.5.4",
    "vite": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "jsqr": "1.4.0",
    "npm": "^11.18.0",
    "supabase": "2.109.0",
    "wrangler": "^4.107.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.25"
    }
  }
}
