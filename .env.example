# Local Vite and Cloudflare previews are browser-local by default. Production
# overrides this to false in the protected main-branch release workflow.
VITE_ENABLE_MOCKS=true
VITE_ENABLE_SUPABASE_AUTH_IN_MOCKS=false
VITE_ENABLE_PRODUCTION_CONNECTIONS=false
VITE_ENABLE_GROUP_INTEGRATIONS=false
# Real production keeps both customer actions closed unless each gate is
# explicitly enabled. Mock mode intentionally keeps the local signup and
# membership preview working regardless of these safe defaults.
VITE_ENABLE_BILLING=false
VITE_ENABLE_PUBLIC_SIGNUP=false

# Leave these placeholders unchanged for ordinary local development. Replace
# them only for the explicit local Auth fixture or in main's production config.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_ENABLE_DOMINION_NIGHT_THEME=false
